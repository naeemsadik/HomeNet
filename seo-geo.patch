@@ -0,0 +1,34 @@
+import { seoAreaBySlug, type SeoArea } from "@/content/areas";
+import { SITE_URL } from "@/lib/seo";
+import type { BreadcrumbCrumb, SchemaNode } from "./types";
+
+export function breadcrumbSchema(crumbs: BreadcrumbCrumb[]): SchemaNode {
+  return {
+    "@type": "BreadcrumbList",
+    itemListElement: crumbs.map((crumb, index) => ({
+      "@type": "ListItem",
+      position: index + 1,
+      name: crumb.name,
+      item: crumb.url,
+    })),
+  };
+}
+
+export type ListingIntent = "buy" | "rent";
+
+export const INTENT_LABEL: Record<ListingIntent, string> = {
+  buy: "Property for Sale",
+  rent: "Property to Rent",
+};
+
+/** Home › Property to Rent › Dhaka › Gulshan, for an area landing page. */
+export function areaCrumbs(area: SeoArea, intent: ListingIntent): BreadcrumbCrumb[] {
+  const crumbs: BreadcrumbCrumb[] = [
+    { name: "Home", url: `${SITE_URL}/` },
+    { name: INTENT_LABEL[intent], url: `${SITE_URL}/${intent}` },
+  ];
+  const parent = seoAreaBySlug(area.parent);
+  if (parent) crumbs.push({ name: parent.name, url: `${SITE_URL}/${intent}/${parent.slug}` });
+  crumbs.push({ name: area.name, url: `${SITE_URL}/${intent}/${area.slug}` });
+  return crumbs;
+}
diff --git a/src/lib/schema/index.ts b/src/lib/schema/index.ts
new file mode 100644
index 0000000..6348def
--- /dev/null
+++ b/src/lib/schema/index.ts
@@ -0,0 +1,45 @@
+/**
+ * Schema.org JSON-LD for search engines and AI answer engines. Each generator
+ * returns one node; `jsonLdDocument` bundles nodes into a single @graph and
+ * <JsonLd> (src/components/JsonLd.tsx) puts it in the page head.
+ */
+import type { JsonLdDocument, SchemaNode, SchemaValue } from "./types";
+
+export * from "./types";
+export * from "./brand";
+export * from "./organization";
+export * from "./breadcrumb";
+export * from "./listing";
+export * from "./valuation";
+
+/** Drops undefined values and empty objects left behind by optional fields. */
+function prune(value: SchemaValue): SchemaValue {
+  if (Array.isArray(value)) {
+    const items = value.map(prune).filter((item) => item !== undefined);
+    return items.length ? items : undefined;
+  }
+  if (value && typeof value === "object") {
+    const entries = Object.entries(value)
+      .map(([key, inner]) => [key, prune(inner)] as const)
+      .filter(([, inner]) => inner !== undefined);
+    // A node left with nothing but its @type says nothing.
+    if (entries.length === 0 || (entries.length === 1 && entries[0][0] === "@type")) return undefined;
+    return Object.fromEntries(entries) as SchemaNode;
+  }
+  return value;
+}
+
+export function jsonLdDocument(...nodes: SchemaNode[]): JsonLdDocument {
+  return {
+    "@context": "https://schema.org",
+    "@graph": nodes.map((node) => prune(node)).filter((node): node is SchemaNode => node !== undefined),
+  };
+}
+
+/**
+ * The document as script-tag text. "<" is escaped so a listing title such as
+ * "</script>" cannot end the tag early; JSON parsers read < as "<".
+ */
+export function serializeJsonLd(doc: JsonLdDocument): string {
+  return JSON.stringify(doc).replace(/</g, "\\u003c");
+}
