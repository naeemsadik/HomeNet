# Copy this file to .env.local and fill in the values for your environment.
# .env.local is git-ignored; this file is committed as documentation only.

# API base URL consumed by Expo and scripts/check-csp.mjs / generate-sitemap.mjs.
# Production (default when env var is absent):
#   EXPO_PUBLIC_API_BASE_URL=https://api.homenetbd.com
# Staging (use this for local dev builds – production API blocks non-Vercel origins):
EXPO_PUBLIC_API_BASE_URL=https://staging-api.homenetbd.com
