# EAS Build uses this file INSTEAD of .gitignore when it exists, so everything
# from .gitignore is repeated here first. Keep the two in step.

# Dependencies
node_modules/

# Expo and Metro
.expo/
.expo-shared/
.metro-health-check*

# Generated builds
web-build/
dist/
coverage/

# Expo prebuild output (EAS prebuilds in the cloud; this project is managed)
android/
ios/

# Environment files (production values live in eas.json / EAS secrets)
.env
.env.*
!.env.example

# Deployment tools
.vercel/

# Native credentials and build artifacts: never uploaded
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.apk
*.aab
*.ipa

# Logs and caches
*.log
.eslintcache
.cache/
.npm/

# Editors and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local API reference material and agent configurations
/docs/
AGENTS.md
CLAUDE.md
.agents/
.claude/
claude/
DESIGN.md
skills-lock.json
.codex/
.21st/
mcp.json

# ── Web-only files the Android app never reads ─────────────────────────────
# The explainer video (~30 MB) is played by the website from /homenet-explainer.mp4;
# the web build (Vercel) is not affected, because it does not use EAS.
public/homenet-explainer.mp4
# Generated by scripts/generate-sitemap.mjs on every web build.
public/sitemap.xml
public/llms.txt
public/llms-full.txt
public/robots.txt
public/googlee*.html
public/og-image.png
vercel.json
