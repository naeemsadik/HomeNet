{
  "name": "homenet",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "node scripts/generate-sitemap.mjs && expo export --platform web && node -e \"require('fs').copyFileSync('dist/+not-found.html', 'dist/404.html')\" && node scripts/check-csp.mjs",
    "export:web": "expo export --platform web",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "smoke:api": "node scripts/api-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:native && npm run check:android",
    "test:native": "jest -c jest.native.config.js",
    "check:android": "node scripts/check-android-release.cjs",
    "android:aab": "eas build --platform android --profile production",
    "android:apk": "eas build --platform android --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.7",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "expo": "~57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "jest-expo": "~57.0.6",
    "leaflet": "^1.9.4",
    "lucide-react-native": "^1.27.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "compression": "^1.8.2",
    "joi": "^17.13.8"
  }
}
